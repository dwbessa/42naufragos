# Discord Developer Portal (discord.com/developers/applications)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
DISCORD_VERIFIED_ROLE_ID=
# opcional: role dada a quem completou o common core (grade "Member" no cursus abaixo)
DISCORD_TRANSCENDER_ROLE_ID=

# intra.42.fr (profile.intra.42.fr/oauth/applications/new)
FT_CLIENT_ID=
FT_CLIENT_SECRET=
# Campus 42 Rio - confirme via GET https://api.intra.42.fr/v2/campus antes de fixar
FT_CAMPUS_ID=28
# slug do cursus principal (common core) usado pra checar se transcendeu (grade "Member")
FT_MAIN_CURSUS_SLUG=42cursus

# URL pública onde o servidor HTTP roda (sem barra no final)
# dev local: use ngrok/cloudflared, a intra não aceita localhost como redirect
PUBLIC_BASE_URL=https://SEU_DOMINIO_OU_TUNEL
OAUTH_REDIRECT_URI=https://SEU_DOMINIO_OU_TUNEL/oauth/callback

PORT=3000
DATABASE_PATH=./data/naufragos.sqlite

# Mural de avaliações próximas (opcional - se vazio, o polling não roda)
DISCORD_MURAL_CHANNEL_ID=
MURAL_WINDOW_HOURS=6
MURAL_POLL_MINUTES=30
